      <Param name="conditions" updates="None" val="[{'domain': 'police_avoidance1', 'question': 'How often do you watch how you dress to avoid getting harassed by the police?', 'minimum': 'Never', 'maximum': 'Always'}, {'domain': 'police_avoidance2', 'question': 'How often do you drive in a way to make sure that you do not attract attention from the police?', 'minimum': 'Never', 'maximum': 'Always'}, {'domain': 'police_avoidance3', 'question': 'Plan drive/walk How often do you plan where to drive/ walk to make sure that you do not attract attention from the police?', 'minimum': 'Never', 'maximum': 'Always'}, {'domain': 'police_avoidance4', 'question': 'How often do you watch how loudly you speak with others to avoid attention from the police?', 'minimum': 'Never', 'maximum': 'Always'}, {'domain': 'police_avoidance5', 'question': 'How often do you feel pressure to remain calm to avoid attention from the police?', 'minimum': 'Never', 'maximum': 'Always'}, {'domain': 'police_avoidance6', 'question': 'How often do you have contact with the police  in your daily life (e.g., seeing, speaking to, or interacting with them)?', 'minimum': 'Never', 'maximum': 'Very often'}]" valType="str"/>
      <Param name="conditionsFile" updates="None" val="police_avoidance.xlsx" valType="file"/>
