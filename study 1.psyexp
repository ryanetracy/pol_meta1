      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="[{'domain': 'fight_or_flight1', 'question': 'You’re walking home alone at night when someone says to stop walking. They are the typical police officer. They are armed. They begin to approach you. To your knowledge, you are doing nothing wrong and are breaking no laws. \nPlease indicate your agreement with the following question:\n\nTo what extent would you be preparing to physically defend yourself?', 'minimum': 'Not at all', 'maximum': 'Extremely'}, {'domain': 'fight_or_flight2', 'question': 'You’re walking home alone at night when someone says to stop walking. They are the typical police officer. They are armed. They begin to approach you. To your knowledge, you are doing nothing wrong and are breaking no laws. \nPlease indicate your agreement with the following question:\n\nTo what extent would you be preparing to run away?', 'minimum': 'Not at all', 'maximum': 'Extremely'}]" valType="str"/>
