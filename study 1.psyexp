      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="[{'domain': 'gblems1', 'question': 'People of your racial group should be suspicious of information from police', 'minimum': 'Strongly disagree', 'maximum': 'Strongly agree'}, {'domain': 'gblems2', 'question': 'People of your racial group cannot trust police', 'minimum': 'Strongly disagree', 'maximum': 'Strongly agree'}, {'domain': 'gblems3', 'question': 'Police treat people of your racial group like ‘animals’', 'minimum': 'Strongly disagree', 'maximum': 'Strongly agree'}, {'domain': 'gblems4', 'question': 'Police do not take the complaints of people of your racial group seriously', 'minimum': 'Strongly disagree', 'maximum': 'Strongly agree'}, {'domain': 'gblems5', 'question': 'People of your racial group should not confide in police because it will be used against them', 'minimum': 'Strongly disagree', 'maximum': 'Strongly agree'}, {'domain': 'gblems6', 'question': 'People of your racial group should be suspicious of the police”', 'minimum': 'Strongly disagree', 'maximum': 'Strongly agree'}, {'domain': 'gblems7', 'question': 'Police sometimes hide information from people who belong to your racial group', 'minimum': 'Strongly disagree', 'maximum': 'Strongly agree'}, {'domain': 'gblems8', 'question': 'Police have the best interests of people of your racial group in mind', 'minimum': 'Strongly disagree', 'maximum': 'Strongly agree'}, {'domain': 'gblems9', 'question': 'You have personally been treated poorly or unfairly by police because of your race', 'minimum': 'Strongly disagree', 'maximum': 'Strongly agree'}]" valType="str"/>
