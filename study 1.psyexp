    <LoopInitiator loopType="TrialHandler" name="group_membership_loop">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="[{'domain': 'group_membership1', 'question': 'To what degree do you view the typical police officer as an ingroup member?', 'minimum': 'Completely outgroup', 'midpoint': 'Equally outgroup and ingroup', 'maximum': 'Completely ingroup'}, {'domain': 'group_membership2', 'question': 'To what degree do you think the typical police officer views themselves as a part of your ingroup?', 'minimum': 'Completely outgroup', 'midpoint': 'Equally outgroup and ingroup', 'maximum': 'Completely ingroup'}, {'domain': 'group_membership3', 'question': 'To what degree do you view the typical police officer as similar to you?', 'minimum': 'Not at all similar', 'midpoint': None, 'maximum': 'Extremely similar'}, {'domain': 'group_membership4', 'question': 'To what degree do you view the typical Black police officer as an ingroup member?', 'minimum': 'Completely outgroup', 'midpoint': 'Equally outgroup and ingroup', 'maximum': 'Completely ingroup'}, {'domain': 'group_membership5', 'question': 'To what degree do you think the typical Black police officer views themselves as a part of your ingroup?', 'minimum': 'Completely outgroup', 'midpoint': 'Equally outgroup and ingroup', 'maximum': 'Completely ingroup'}, {'domain': 'group_membership6', 'question': 'To what degree do you view the typical Black police officer as similar to you?', 'minimum': 'Not at all similar', 'midpoint': None, 'maximum': 'Extremely similar'}, {'domain': 'group_membership7', 'question': 'To what degree do you view the typical White police officer as an ingroup member?', 'minimum': 'Completely outgroup', 'midpoint': 'Equally outgroup and ingroup', 'maximum': 'Completely ingroup'}, {'domain': 'group_membership8', 'question': 'To what degree do you think the typical White police officer views themselves as a part of your ingroup?', 'minimum': 'Completely outgroup', 'midpoint': 'Equally outgroup and ingroup', 'maximum': 'Completely ingroup'}, {'domain': 'group_membership9', 'question': 'To what degree do you view the typical White police officer as similar to you?', 'minimum': 'Not at all similar', 'midpoint': None, 'maximum': 'Extremely similar'}, {'domain': 'group_membership10', 'question': 'To what degree do you view the typical Black man as an ingroup member?', 'minimum': 'Completely outgroup', 'midpoint': 'Equally outgroup and ingroup', 'maximum': 'Completely ingroup'}, {'domain': 'group_membership11', 'question': 'To what degree do you think the typical Black man views themselves as a part of your ingroup?', 'minimum': 'Completely outgroup', 'midpoint': 'Equally outgroup and ingroup', 'maximum': 'Completely ingroup'}, {'domain': 'group_membership12', 'question': 'To what degree do you view the typical Black man as similar to you?', 'minimum': 'Not at all similar', 'midpoint': None, 'maximum': 'Extremely similar'}, {'domain': 'group_membership13', 'question': 'To what degree do you view the typical White man as an ingroup member?', 'minimum': 'Completely outgroup', 'midpoint': 'Equally outgroup and ingroup', 'maximum': 'Completely ingroup'}, {'domain': 'group_membership14', 'question': 'To what degree do you think the typical White man views themselves as a part of your ingroup?', 'minimum': 'Completely outgroup', 'midpoint': 'Equally outgroup and ingroup', 'maximum': 'Completely ingroup'}, {'domain': 'group_membership15', 'question': 'To what degree do you view the typical White man as similar to you?', 'minimum': 'Not at all similar', 'midpoint': None, 'maximum': 'Extremely similar'}]" valType="str"/>
      <Param name="conditionsFile" updates="None" val="group_membership.xlsx" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="num"/>
      <Param name="isTrials" updates="None" val="True" valType="bool"/>
