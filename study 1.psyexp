  <Flow>
    <LoopInitiator loopType="TrialHandler" name="intro_loop">
      <Param name="Selected rows" updates="None" val="1" valType="str"/>
      <Param name="conditions" updates="None" val="[{'intro': &quot;Research shows that people hold mental representations of 'typical' members of social categories.\n\nWe are interested in your mental representation of how the 'typical' police officer views Black men.\n\nPress the SPACE BAR to continue!&quot;, 'overall_instr': &quot;In this study, you will see two faces side-by-side. As per the instructions you will see at the top of the screen, you will be asked to indicate which of these faces looks MOST like how a 'typical' police officer views Black men.\n\nIf you believe the face on the left matches this perception, press the LEFT arrow key. Otherwise, if you believe the face on the right matches this perception, press the RIGHT arrow key.\n\nRealize that there are no right or wrong answers in this paradigm. We are only interested in how you think the 'typical' police officer views Black men.\n\nPress the SPACE BAR to begin the study!&quot;, 'category_instr': 'Which face looks most like how a typical police officer views Black men?', 'inverse_image': 'stimuli/rcic_base_1_00001_inv.png', 'original_image': 'stimuli/rcic_base_1_00001_ori.png', 'inv_loc_X': -300, 'ori_loc_X': 300, 'inv_loc_Y': 0, 'ori_loc_Y': 0}, {'intro': &quot;Research shows that people hold mental representations of 'typical' members of social categories.\n\nWe are interested in your mental representation of how the 'typical' police officer views Black men.\n\nPress the SPACE BAR to continue!&quot;, 'overall_instr': &quot;In this study, you will see two faces side-by-side. As per the instructions you will see at the top of the screen, you will be asked to indicate which of these faces looks MOST like how a 'typical' police officer views Black men.\n\nIf you believe the face on the left matches this perception, press the LEFT arrow key. Otherwise, if you believe the face on the right matches this perception, press the RIGHT arrow key.\n\nRealize that there are no right or wrong answers in this p